# Copy this file to `.env` (same folder) and fill in the values.
# `.env` must never be committed to git.

# ── AI models (required) ─────────────────────────────────────────
GROQ_API_KEY=            # https://console.groq.com/keys
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
MISTRAL_API_KEY=         # https://console.mistral.ai/api-keys  (free "Experiment" plan)

# ── Web search (required) ────────────────────────────────────────
TAVILY_API_KEY=          # https://app.tavily.com  (free: 1,000 credits/month)
EXA_API_KEY=             # https://dashboard.exa.ai/api-keys

# ── Database (required) ──────────────────────────────────────────
# Supabase → Project → Connect → "Session pooler" connection string (Postgres URI)
DATABASE_URL=            # postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres

# ── App settings (you choose these) ──────────────────────────────
DEMO_ACCESS_CODE=        # passcode reviewers type to open the app
SEC_CONTACT_EMAIL=       # SEC EDGAR requires a contact email in the User-Agent; leave blank to skip SEC

# ── Optional (raise free rate limits) ────────────────────────────
GITHUB_TOKEN=            # https://github.com/settings/tokens  (fine-grained, no scopes needed)
JINA_API_KEY=            # https://jina.ai/reader  (works without a key at lower limits)
