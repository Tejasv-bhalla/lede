# Copy this file to `.env` (same folder) and fill in the values.
# `.env` must never be committed to git.

# ── AI models (required) ─────────────────────────────────────────
GROQ_API_KEY=            # https://console.groq.com/keys
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
MISTRAL_API_KEY=         # optional: new free Mistral accounts can no longer activate keys (Oct 2026)

# ── Web search (required) ────────────────────────────────────────
TAVILY_API_KEY=          # https://app.tavily.com  (free: 1,000 credits/month)
EXA_API_KEY=             # https://dashboard.exa.ai/api-keys

# ── Database (required for deployment) ──────────────────────────────────────────
# Neon → project → Connect → connection pooling OFF → copy the string (keep ?sslmode=require...)
# Leave blank for local development: the app then uses a SQLite file in backend/.
DATABASE_URL=            # postgresql://neondb_owner:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── App settings (you choose these) ──────────────────────────────
DEMO_ACCESS_CODE=        # passcode reviewers type to open the app
SETTINGS_SECRET=         # encrypts model keys saved in the app; any long random string, e.g. `openssl rand -hex 32`
CLAUDE_CODE_LOCAL=        # true = offer "Claude Code on this computer" as a model (local demos only; never on a server)
SEC_CONTACT_EMAIL=       # not used yet: reserved for a planned SEC EDGAR connector

# ── Optional (raise free rate limits) ────────────────────────────
GITHUB_TOKEN=            # not used yet: reserved for a planned GitHub connector
JINA_API_KEY=            # https://jina.ai/reader  (works without a key at lower limits)
HUNTER_API_KEY=          # https://hunter.io/api-keys  finds a contact's work email when no page read shows it (free plan: a small monthly allowance; a credit is used only when an address is found)
